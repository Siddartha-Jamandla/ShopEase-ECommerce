# ShopEase backend configuration.
# Copy to backend/.env and adjust. (Loaded manually - see README.)
# The backend reads these from the environment; example:
#   set -a; source backend/.env; set +a; python3 backend/app.py

# Port the API + frontend server listens on
SHOPEASE_PORT=8000

# Secret key required in the X-Admin-Key header for POST /api/products.
# CHANGE THIS before any public deployment.
SHOPEASE_ADMIN_KEY=admin-secret-change-me
